[Unit]
Description=MeshCore <-> Meshtastic BLE bridge
Requires=bluetooth.service
After=bluetooth.service hciuart.service
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
# Type=notify + WatchdogSec: bridge posila READY a pravidelne WATCHDOG=1;
# prestane-li (zaseknuty event loop ci health self-check), systemd ho
# restartuje. Vice v README (Watchdog hardening).
Type=notify
WatchdogSec=180
# __BRIDGE_USER__/__BRIDGE_HOME__ are filled in by install.sh (current user)
User=__BRIDGE_USER__
Group=__BRIDGE_USER__
SupplementaryGroups=bluetooth
WorkingDirectory=__BRIDGE_HOME__/mesh-bridge
ExecStart=__BRIDGE_HOME__/mesh-bridge/venv/bin/python3 -u bridge.py
Restart=always
RestartSec=15
# meshtastic BLE close can hang; shorter service stop timeout
TimeoutStopSec=20
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
